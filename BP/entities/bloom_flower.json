{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "succulents:bloom_flower",
            "is_spawnable": false,
            "is_summonable": true,
            "spawn_category": "creature"
        },
        "component_groups": {
            "succulents:alive": {
                "minecraft:timer": {
                    "time": [
                        160,
                        240
                    ],
                    "looping": false,
                    "time_down_event": {
                        "event": "succulents:dry",
                        "target": "self"
                    }
                }
            },
            "succulents:dry": {
                "minecraft:spell_effects": {
                    "add_effects": [
                        {
                            "effect": "invisibility",
                            "duration": 999999
                        }
                    ]
                },
                "minecraft:timer": {
                    "time": [
                        1,
                        1
                    ],
                    "looping": false,
                    "time_down_event": {
                        "event": "succulents:die",
                        "target": "self"
                    }
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "succulents"
                ]
            },
            "minecraft:health": {
                "value": 6,
                "max": 6
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:no_gravity": {},
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:collision_box": {
                "width": 0.4,
                "height": 0.5
            },
            "minecraft:timer": {
                "time": [
                    2,
                    3
                ],
                "looping": false,
                "time_down_event": {
                    "event": "succulents:verify",
                    "target": "self"
                }
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "run_command": {
                    "command": [
                        "tag @s add succulents_fresh"
                    ]
                },
                "add": {
                    "component_groups": [
                        "succulents:alive"
                    ]
                }
            },
            "succulents:verify": {
                "run_command": {
                    "command": [
                        "execute if entity @e[type=succulents:bloom_flower,tag=!succulents_fresh,r=0.5] run kill @s",
                        "execute unless block ~ ~-1 ~ succulents:echeveria_derenbergii run execute unless block ~ ~-1 ~ succulents:echeveria_elegans run execute unless block ~ ~-1 ~ succulents:echeveria_fallax run kill @s",
                        "tag @s remove succulents_fresh"
                    ]
                }
            },
            "succulents:dry": {
                "add": {
                    "component_groups": [
                        "succulents:dry"
                    ]
                }
            },
            "succulents:die": {
                "run_command": {
                    "command": [
                        "kill @s"
                    ]
                }
            }
        }
    }
}